{
  "name": "k3progetti/software-version-bundle",
  "description": "Bundle Symfony che manda al server delle versioni il PHP e il Symfony che girano davvero nel progetto",
  "type": "composer-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Mattia Vitali",
      "email": "m.vitali@k3progetti.it"
    }
  ],
  "require": {
    "composer-plugin-api": "^2.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "php": ">=7.2.5",
    "symfony/config": "^5.4 || ^6.0 || ^7.0 || ^8.0",
    "symfony/console": "^5.4 || ^6.0 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0 || ^8.0",
    "symfony/event-dispatcher": "^5.4 || ^6.0 || ^7.0 || ^8.0",
    "symfony/framework-bundle": "^5.4 || ^6.0 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0 || ^8.0",
    "symfony/yaml": "^5.4 || ^6.0 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "K3Progetti\\SoftwareVersionBundle\\": "src/"
    }
  },
  "extra": {
    "class": "K3Progetti\\SoftwareVersionBundle\\Composer\\Plugin",
    "branch-alias": {
      "dev-main": "3.0-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "composer/composer": "^2.0"
  }
}
